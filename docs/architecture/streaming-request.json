  "cards": [
    {
      "dot": "amber",
      "title": "Before the first byte",
      "items": [
        "Response headers wait for the first upstream event",
        "Failures keep their real status: 400, 401, 429, 504 or 529",
        "retry-after is sent when the reset time is known"
      ]
    },
    {
      "dot": "cyan",
      "title": "Retries",
      "items": [
        "5xx, network and timeout errors: up to UPSTREAM_RETRIES per request",
        "Exponential backoff with jitter; a longer Retry-After wins",
        "A 429 cools the account down and rotates to the next one"
      ]
    },
    {
      "dot": "rose",
      "title": "After the first byte",
      "items": [
        "A started stream is never replayed or moved to another account",
        "A mid-stream failure becomes an SSE error event",
        "Client disconnect stops further upstream retries"
      ]
    }
  ]
