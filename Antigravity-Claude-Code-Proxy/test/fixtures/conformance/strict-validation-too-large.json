{
  "name": "strict-validation-too-large",
  "profile": "strict",
  "description": "Bodies above REQUEST_BODY_LIMIT -> 413 request_too_large.",
  "request": {
    "body": {
      "model": "gemini-3-flash",
      "max_tokens": 64,
      "messages": [
        {
          "role": "user",
          "content": ""
        }
      ]
    }
  },
  "upstream": [],
  "expect": {
    "status": 413,
    "upstreamCalls": [],
    "body": {
      "type": "error",
      "error": {
        "type": "request_too_large"
      }
    }
  }
}
