{
  "name": "validation-empty-messages",
  "profile": "default",
  "description": "An empty messages array is rejected.",
  "request": {
    "body": {
      "model": "gemini-3-flash",
      "max_tokens": 16,
      "messages": []
    }
  },
  "upstream": [],
