# Copy to .env (next to package.json) and fill in what you need.
# .env is git-ignored; never commit real values.

# --- Google sign-in (required to add accounts and refresh tokens) ---
# The OAuth client secret is NOT stored in this repository.
# Use the Desktop-app OAuth client from your own Google Cloud project,
# or the client your Antigravity tooling already uses.
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: only when you use your own OAuth app (defaults to the built-in client id).
# GOOGLE_OAUTH_CLIENT_ID=
# OAUTH_CALLBACK_PORT=51121

# --- Server ---
# PORT=8080
# Keep 127.0.0.1 unless you really want other machines to reach the proxy (it has no auth).
# HOST=127.0.0.1
# Extra comma-separated browser origins allowed to call the proxy.
# CORS_ALLOWED_ORIGINS=
# LOG_LEVEL=info

# Requests larger than this get 413 request_too_large (matches the Anthropic API limit).
# REQUEST_BODY_LIMIT=32mb
# Per-client requests per minute for the management/dashboard endpoints (the Messages API is exempt).
# MANAGEMENT_RATE_LIMIT=300
# How long a graceful shutdown waits for in-flight requests and streams (ms).
# SHUTDOWN_TIMEOUT=30000

# --- Upstream compatibility ---
# Antigravity client version sent in the User-Agent (dotted x.y.z). Google rejects old versions with
# "This version of Antigravity is no longer supported"; set this to the version of your installed
# Antigravity IDE (Help > About) if that happens. Invalid values are ignored with a warning.
# ANTIGRAVITY_VERSION=2.5.5
# Base URL of the separate Perplexity backend server used by perplexity-*/pplx-* models
# (not part of this package). Gemini and Claude models do not need it. http(s) only, a path is
# allowed; credentials (user:password@), a query string or a fragment are refused.
# PERPLEXITY_SERVER_URL=http://localhost:8000

# --- Upstream resilience ---
# Deadline for upstream response headers (ms); streams get 5x this for the whole stream.
# REQUEST_TIMEOUT=60000
# Retries per request for 5xx, network and timeout errors (timeouts are retried at most once).
# UPSTREAM_RETRIES=2
# Exponential backoff with full jitter: base and cap in ms. A longer Retry-After always wins.
# RETRY_BASE_MS=500
# RETRY_MAX_MS=8000
# Attempts across accounts when accounts are rate-limited or invalid.
# MAX_RETRIES=5
# Status when every account is out of quota: 400 (default, stops client retries) or 429 (+ retry-after).
# RATE_LIMIT_STATUS=400
# Wait for rate limits to reset instead of failing; MAX_WAIT_BEFORE_ERROR caps short waits (ms).
# AUTO_WAIT_FOR_RATE_LIMIT=true
# MAX_WAIT_BEFORE_ERROR=120000

# --- Storage ---
# ACCOUNT_CONFIG_PATH=~/.config/antigravity-proxy/accounts.json
# PROXY_STATE_DIR=

# --- Testing ---
# Comma-separated upstream override; the offline tests point this at a mock server.
# CLOUDCODE_ENDPOINTS=
